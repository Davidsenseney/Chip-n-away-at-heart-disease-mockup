# ---------------------------------------------------------------
# Chip'n Away — environment variables
# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored — never commit real keys.
# Vite only exposes variables that start with VITE_.
# After editing .env, restart `npm run dev`.
# ---------------------------------------------------------------

# [WIX] Headless OAuth client ID
# Wix dashboard > Settings > Development & integrations > Headless Settings
VITE_WIX_CLIENT_ID=

# [WIX] Live Wix site URL, no trailing slash. Used for backend calls
# like /_functions/sendEmail (volunteer form).
VITE_WIX_SITE_URL=https://www.chipnaway.com

# [CAMPAIGN] Wix Donations campaign ID (a GUID)
# Wix dashboard > Donations > open the campaign (see README for how to find the ID)
VITE_WIX_DONATION_CAMPAIGN_ID=

# [FORMSPREE] Formspree form endpoint for volunteer form submissions
# Formspree dashboard > Forms > Form endpoint (e.g., https://formspree.io/f/YOUR_FORM_ID or just YOUR_FORM_ID)
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

