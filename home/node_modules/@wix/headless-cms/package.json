{
  "name": "@wix/headless-cms",
  "version": "0.0.45",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "vitest",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "files": [
    "dist",
    "cjs",
    "react",
    "services"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./cjs/dist/react/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "require": "./cjs/dist/services/index.js"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^20.9.0",
    "@vitest/ui": "^3.1.4",
    "@wix/headless-components": "0.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@wix/data": "^1.0.0",
    "@wix/headless-ecom": "0.0.40",
    "@wix/headless-utils": "0.0.8",
    "@wix/services-definitions": "^1.0.1",
    "@wix/services-manager-react": "^1.0.3"
  },
  "peerDependencies": {
    "@wix/headless-components": "^0.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "wix": {
    "artifact": {
      "artifactId": "headless-cms",
      "groupId": "com.wixpress.headless-components"
    }
  },
  "falconPackageHash": "cbfe6f9fbd6422b83d1603b242c237c1eeb7fce2acd960de5f52a252"
}