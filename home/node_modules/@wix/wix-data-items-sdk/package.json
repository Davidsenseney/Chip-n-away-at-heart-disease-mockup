{
  "name": "@wix/wix-data-items-sdk",
  "version": "1.0.552",
  "license": "UNLICENSED",
  "author": {
    "name": "Rimvydas Gimbutas",
    "email": "rimvydasg@wix.com"
  },
  "main": "build/cjs/index.js",
  "module": "build/es/index.js",
  "sideEffects": false,
  "typings": "./build/cjs/index.d.ts",
  "files": [
    "build",
    "frontend/package.json",
    "meta",
    "context"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json tsconfig.esm.json",
    "build:all": "yarn workspace @wix/wix-data-items-common build && yarn build",
    "lint": "yarn lint:prettier && yarn lint:eslint",
    "test": "jest",
    "lint:eslint": "eslint",
    "lint:prettier": "prettier . --check",
    "format": "prettier . --write",
    "docs": "docs-ts-model --config docs-ts-model.config.json"
  },
  "lint-staged": {
    "*.{js,ts}": "yarn lint"
  },
  "dependencies": {
    "@wix/sdk-runtime": "^1.0.24",
    "@wix/sdk-types": "^1.17.11",
    "@wix/wix-data-items-common": "1.0.328"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.130",
    "@wix/docs-ts-model": "^1.58.0",
    "@wix/sdk": "^1.21.16",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "fs-extra": "^11.3.2",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "~5.1.0",
    "typescript-eslint": "^8.47.0"
  },
  "wix": {
    "artifact": {
      "artifactId": "wix-data-items-sdk",
      "groupId": "com.wixpress.public-sdk-dependencies"
    },
    "validations": {
      "postDependenciesBuild": [
        "lint"
      ]
    },
    "sdkDependency": {
      "fqdnNamespace": "items",
      "fqdn": "wix.data.v2.data_item"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@wix|flat))",
      ".*/filter-builder/dist/.*",
      ".*/wix-data-items-common/dist/.*"
    ],
    "transform": {
      "^.+\\.(tsx?|jsx?)$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    }
  },
  "prettier": {
    "singleQuote": true,
    "semi": false
  },
  "wallaby": {
    "autoDetect": true
  },
  "falconPackageHash": "776a1a49dd5509925913f681aea077fbb03c675d86726bed5b08ccc9"
}